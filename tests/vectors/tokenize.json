{
  "description": "Разбиение адреса на значимые слова",
  "cases": [
    {
      "input": "г. Ярославль, Советская ул, дом № 57",
      "expected": [
        "ярославль",
        "советская"
      ]
    },
    {
      "input": "Усть-Ордынский п, Ленина ул",
      "expected": [
        "усть",
        "ордынский",
        "ленина"
      ]
    },
    {
      "input": "Кремлёвская улица, Орёл",
      "expected": [
        "кремлевская",
        "орел"
      ]
    },
    {
      "input": "муниципальное образование Екатеринбург",
      "expected": [
        "екатеринбург"
      ]
    }
  ]
}
